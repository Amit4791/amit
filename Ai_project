hud_canvas = tk.Canvas(window, width=200, height=200, bg='#1B1B2F', highlightthickness=0)
hud_canvas.place(x=50, y=100)

def update_hud():
    hud_canvas.delete("all")
    cpu_percent = psutil.cpu_percent()
    hud_canvas.create_oval(20, 20, 180, 180, outline="#00FFEA", width=3)
    hud_canvas.create_arc(20, 20, 180, 180, start=90, extent=-cpu_percent*3.6, style='arc', outline="#FF073A", width=5)
    hud_canvas.create_text(100, 100, text=f"CPU\n{cpu_percent}%", fill="#00FFEA", font=("Orbitron", 12, "bold"))

    if hasattr(psutil, "sensors_battery"):
        battery = psutil.sensors_battery()
        if battery:
            hud_canvas.create_text(100, 140, text=f"Battery\n{int(battery.percent)}%", fill="#00FFEA", font=("Orbitron", 10, "bold"))

    window.after(1000, update_hud)

update_hud()

# --- Floating AI Responses ---
def float_text(message):
    float_label = tk.Label(window, text=message, font=("Orbitron", 12, "bold"), fg="#00FFEA", bg="#1B1B2F")
    float_label.place(x=1024, y=600)
    def move():
        x, y = float_label.winfo_x(), float_label.winfo_y()
        if x > 700:
            float_label.place(x=x-5, y=y)
            window.after(30, move)
        else:
            float_label.destroy()
    move()

def animate_text(message, index):
    if index <= len(message):
        text_area.delete('1.0', tk.END)
        text_area.insert(tk.END, message[:index])
        text_area.see(tk.END)
        window.after(20, lambda: animate_text(message, index + 1))
    if index == len(message):
        float_text(message)

# --- Jarvis Loop ---
def run_jarvis():
    speak("I am your personal assistant.")
    get_command_loop()

def get_command_loop():
    command = take_command()
    if command == "None":
        window.after(500, get_command_loop)
    else:
        animate_text(f"[You]: {command}\n", 0)
        execute_command(command)
        window.after(500, get_command_loop)

window.after(1000, run_jarvis)
window.mainloop()
