engine = pyttsx3.init()
engine.setProperty('rate', 180)        
engine.setProperty('volume', 1.0)      

voices = engine.getProperty('voices')
for voice in voices:
    if 'female' in voice.name.lower() or 'zira' in voice.name.lower() or 'samantha' in voice.name.lower():
        engine.setProperty('voice', voice.id)
        break

def speak(text):
    engine.say(text)
    engine.runAndWait()

def take_command():
    r = sr.Recognizer()
    with sr.Microphone() as source:
        r.pause_threshold = 1
        r.energy_threshold = 300
        audio = r.listen(source)
    try:
        command = r.recognize_google(audio, language='en-in')
    except Exception:
        return "None"
    return command.lower()

EXIT_COMMANDS = ['exit', 'stop', 'bye', 'goodbye', 'bye jarvis', 'goodbye jarvis']

def execute_command(command):
    if any(cmd in command for cmd in EXIT_COMMANDS):
        text_area.insert(tk.END, "Jarvis stopped.\n")
        speak("Goodbye Sir!")
        os._exit(0)

    elif 'play' in command:
        song = command.replace('play', '').strip()
        text_area.insert(tk.END, f"Playing {song} on YouTube\n")
        pywhatkit.playonyt(song)

    elif 'time' in command:
        time_str = datetime.datetime.now().strftime('%I:%M %p')
        text_area.insert(tk.END, f"Time: {time_str}\n")

    elif 'who is' in command or 'what is' in command:
        person = command
        if 'who is' in command:
            person = command.replace('who is', '').strip()
        elif 'what is' in command:
            person = command.replace('what is', '').strip()

        try:
            info = wikipedia.summary(person, sentences=2)
            text_area.insert(tk.END, f"Wikipedia: {info}\n")
            speak(info)  

        except wikipedia.exceptions.DisambiguationError as e:
            info = wikipedia.summary(e.options[0], sentences=2)
            text_area.insert(tk.END, f"Wikipedia (suggestion {e.options[0]}): {info}\n")
            speak(info)

        except Exception:
            text_area.insert(tk.END, "No Wikipedia info found. Searching on Google...\n")
            speak("I couldn't find it on Wikipedia. I am searching on Google.")
            query = person.replace(' ', '+')
            webbrowser.open(f"https://www.google.com/search?q={query}")

    elif 'shutdown' in command:
        os.system('shutdown /s /t 1')

    elif 'restart' in command:
        os.system('shutdown /r /t 1')

    elif 'log off' in command:
        os.system('shutdown -l')

    elif 'open' in command:
        site = command.replace('open', '').strip()
        if site:
            if '.' in site:
                url = site if site.startswith('https://') else 'https://' + site
            else:
                url = f'https://www.{site}.com'
            text_area.insert(tk.END, f"Opening {site}\n")
            webbrowser.open(url)

    else:
        math_pattern = r'^[0-9+\-*/(). ]+$'
        if re.match(math_pattern, command.replace(' ', '')):
            try:
                result = eval(command)
                text_area.insert(tk.END, f"Result: {result}\n")
                speak(f"The result is {result}")
            except Exception:
                text_area.insert(tk.END, "Error in calculation.\n")
                speak("Sorry, I cannot calculate that.")
        else:
            text_area.insert(tk.END, f"Command: {command}\n")

def run_jarvis():
    text_area.insert(tk.END, "Jarvis: I am your personal assistant.\n")
    speak("I am your personal assistant.")

    while True:
        command = take_command()

        if command == "None":
            continue

        text_area.insert(tk.END, f"You said: {command}\n")

        Thread(target=execute_command, args=(command,)).start()

        time.sleep(0.5)


